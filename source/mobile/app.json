{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-minha-tirinha.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.minhatirinha.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCFAEE",
        "foregroundImage": "./assets/images/logo-minha-tirinha.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.minhatirinha.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-minha-tirinha.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-minha-tirinha.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FCFAEE",
          "dark": {
            "backgroundColor": "#FCFAEE"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps._some_id_here_"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
